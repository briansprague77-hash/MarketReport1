# Copy to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.
# For Vercel deploys, set the same variables in Project Settings → Environment Variables.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com, then find these under Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Browser-safe key for client auth + reads with RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — bypasses RLS. NEVER expose on the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Resend (Email) ──────────────────────────────────────────────────────────
# Sign up at https://resend.com, create an API key
RESEND_API_KEY=re_your_api_key

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Group invite URL for the realtor/sales-agent chat (rendered at /brokers).
# In WhatsApp: group → "Invite to Group via Link" → Copy.
NEXT_PUBLIC_BROKER_WA_GROUP_INVITE=https://chat.whatsapp.com/YOUR_INVITE_CODE

# Brian's WhatsApp Business number for /brokers/[code] direct chat.
# E.164 format WITHOUT the + (e.g., 17275551234).
NEXT_PUBLIC_BROKER_WA_NUMBER=

# ─── Auth (post-migration) ───────────────────────────────────────────────────
# Email allowed to access /admin/* routes (single admin).
ADMIN_EMAIL=brian@tampabaymarketreport.com
# Secret for the daily alerts cron (/api/cron/alerts). Vercel auto-sends it as
# Authorization: Bearer $CRON_SECRET to scheduled requests when this is set.
CRON_SECRET=generate-a-long-random-string
# 'shadow' during migration (default — old localStorage tier still works).
# Switch to 'strict' after Task 15 cutover.
NEXT_PUBLIC_AUTH_ENFORCE=shadow
